generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  displayName   String?
  avatarUrl     String?
  language      String         @default("en")
  plan          String         @default("FREE") // "FREE", "PRO", "VIP"
  
  // Rate limiting
  dailyTokensUsed   Int        @default(0)
  dailyTokensLimit  Int        @default(100000)
  lastTokenReset    DateTime   @default(now())
  
  conversations Conversation[]
  messages      Message[]
  pinnedItems   PinnedItem[]
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Conversation {
  id          String     @id @default(uuid())
  title       String     @default("New Chat")
  isPinned    Boolean    @default(false)
  
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  messages    Message[]
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  @@index([userId, updatedAt])
}

model Message {
  id              String       @id @default(uuid())
  role            String       // "USER", "ASSISTANT", "SYSTEM"
  content         String
  
  // Streaming status
  isStreaming      Boolean      @default(false)
  
  // Token usage
  promptTokens    Int?
  completionTokens Int?
  
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  attachments     Attachment[]
  pinnedItems     PinnedItem[]
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([conversationId, createdAt])
}

model Attachment {
  id          String         @id @default(uuid())
  fileName    String
  fileType    String         // MIME type
  fileSize    Int            // bytes
  storageKey  String         // S3/R2 key
  url         String?        // Pre-signed or public URL
  
  messageId   String?
  message     Message?       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime       @default(now())
}

model PinnedItem {
  id          String     @id @default(uuid())
  
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  messageId   String
  message     Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime   @default(now())
  
  @@unique([userId, messageId])
}

model Document {
  id          String          @id @default(uuid())
  fileName    String
  fileType    String
  fileSize    Int
  status      String          // "PENDING", "PROCESSED", "ERROR"
  isEnabled   Boolean         @default(true)
  chunks      DocumentChunk[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model DocumentChunk {
  id          String   @id @default(uuid())
  content     String
  embedding   String   // Stores JSON-serialized float array (text in SQLite, maps to text/vector in pgvector)
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model DirectFact {
  id          String   @id @default(uuid())
  content     String
  embedding   String   // Stores JSON-serialized float array (text in SQLite, maps to text/vector in pgvector)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


